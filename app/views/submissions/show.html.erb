<% content_for :notice_displayed_in_page, "true" %>
<% prepare_comment_votes(@comments, include_replies: true) %>
<div class="submission-detail">
<% if notice.present? %>
  <p class="submission-notice" role="status"><%= notice %></p>
<% end %>

<div class="submission-back-nav">
  <%= link_to submissions_path do %>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M19 12H5m6-6-6 6 6 6" />
    </svg>
    <span>Back to submissions</span>
  <% end %>
</div>

<%= render @submission %>

<% if current_user == @submission.user %>
<nav class="submission-actions" aria-label="Submission actions">
  <%= link_to "Edit", edit_submission_path(@submission) %>
  <%= button_to "Delete", @submission, method: :delete,
                form: { data: { turbo_confirm: "Delete this submission and all its comments and replies? This cannot be undone." } } %>
</nav>
<p class="submission-back-nav">Deleting this submission permanently deletes all its comments and replies.</p>
<% end %>

<section id="comments" class="comments-section" aria-label="Comentaris">
  <% if current_user %>
    <div class="new-comment">
      <%= render "comments/form", submission: @submission, comment: @comment %>
    </div>
  <% else %>
    <div class="comment-login-prompt">
      <p>Per comentar, cal iniciar sessió.</p>
      <%= button_to "Inicia sessió amb GitHub", "/auth/github", method: :post,
                    form: { data: { turbo: false } }, class: "hn-auth-button" %>
    </div>
  <% end %>

  <div class="comments-list">
    <%= render partial: "comments/comment", collection: @comments, as: :comment,
               locals: { submission: @submission } %>
  </div>
</section>
</div>
