<% content_for :title, "Submit" %>

<div class="submit-page">
  <h1>Submit</h1>

  <%= render "form", submission: @submission %>

  <p class="submit-help">Leave the URL blank to submit an Ask post. If there is a URL, text is optional.</p>

  <div class="submit-back-link">
    <%= link_to "Back to submissions", submissions_path %>
  </div>
</div>
