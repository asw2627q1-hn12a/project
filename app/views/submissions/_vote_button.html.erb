<% if current_user && submission.user_id != current_user.id %>
  <%= button_to (voted ? "unvote" : "▲"),
                submission_vote_path(submission),
                method: voted ? :delete : :post,
                class: "hn-vote-button#{' hn-vote-button--arrow' unless voted}",
                title: voted ? "unvote" : "upvote",
                aria: { label: voted ? "unvote" : "vote" },
                form: { class: "hn-vote-form" } %>
<% end %>
