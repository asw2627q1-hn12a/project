<%= form_with(model: submission) do |form| %>
  <% if submission.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(submission.errors.count, "error") %> impidieron guardar la submission:</h2>
      <ul>
        <% submission.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "title" %><br>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :url, "url" %><br>
    <%= form.text_field :url %>
  </div>

  <div>
    <%= form.label :text, "text" %><br>
    <%= form.text_area :text, rows: 4 %>
  </div>

  <div>
    <%= form.label :user_id, "User" %><br>
    <%= form.collection_select :user_id, User.all, :id, :username %>
  </div>

  <div>
    <%= form.submit "submit" %>
  </div>
<% end %>