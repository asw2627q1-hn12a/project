<%= form_with(model: submission, class: "submission-form") do |form| %>
  <% if submission.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(submission.errors.count, "error") %> impidieron guardar la submission:</h2>
      <ul>
        <% submission.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="submission-form-field">
    <%= form.label :title, "title" %>
    <%= form.text_field :title, required: true %>
  </div>

  <div class="submission-form-field">
    <%= form.label :url, "url" %>
    <%= form.url_field :url, placeholder: "https://example.com" %>
  </div>

  <div class="submission-form-field">
    <%= form.label :text, "text" %>
    <%= form.text_area :text, rows: 4 %>
  </div>

  <div class="submission-form-actions">
    <%= form.submit(submission.persisted? ? "update" : "submit") %>
  </div>
<% end %>
