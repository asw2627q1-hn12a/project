<% content_for :notice_displayed_in_page, "true" %>
<% if notice.present? %>
  <p class="hn-notice"><%= notice %></p>
<% end %>

<% if action_name == "search" %>
  <section class="hn-search" aria-labelledby="search-heading">
    <h1 id="search-heading">Search submissions</h1>
    <% if @query.present? %>
      <% if @submissions.empty? %>
        <p role="status">No submissions found for “<%= @query %>”. Try another word.</p>
      <% else %>
        <p>Results for “<%= @query %>”, sorted by relevance.</p>
      <% end %>
    <% else %>
      <p>Enter a word to search submission titles.</p>
    <% end %>
  </section>
<% end %>

<table class="hn-itemlist" border="0" cellpadding="0" cellspacing="0">
  <tbody>
    <% @submissions.each_with_index do |submission, index| %>
      <!-- Fila 1: Ranking, flecha de voto, título y dominio -->
      <tr class="athing" id="submission_<%= submission.id %>">
        <td align="right" valign="top" class="title">
          <span class="rank"><%= index + 1 %>.</span>
        </td>
        <td valign="top" class="votelinks">
          <% unless @voted_submission_ids.include?(submission.id) %>
            <%= render "submissions/vote_button", submission: submission, voted: false %>
          <% end %>
        </td>
        <td class="title">
          <span class="titleline">
            <% if action_name == "search" || submission.url.blank? %>
              <%= link_to submission.title, submission_path(submission) %>
            <% else %>
              <a href="<%= submission.url %>" target="_blank" rel="noopener"><%= submission.title %></a>
            <% end %>
            <% if submission.domain.present? %>
              <span class="sitebit comhead">
                (<a href="<%= submission.url %>"><span class="sitestr"><%= submission.domain %></span></a>)
              </span>
            <% end %>
          </span>
        </td>
      </tr>

      <!-- Fila 2: Puntos, usuario creador, tiempo transcurrido y acciones -->
      <tr>
        <td colspan="2"></td>
        <td class="subtext">
          <span class="score"><%= submission.points %> points</span>
          by <a href="<%= user_path(submission.user) %>" class="hnuser"><%= submission.user.username %></a>
          <span class="age">
            <a href="<%= submission_path(submission) %>"><%= time_ago_in_words(submission.created_at) %> ago</a>
          </span>
          <% if @voted_submission_ids.include?(submission.id) %>
            | <%= render "submissions/vote_button", submission: submission, voted: true %>
          <% end %>
          | <a href="<%= submission_path(submission) %>">discuss</a>
        </td>
      </tr>

      <!-- Fila 3: Espaciador de 5px exacto al de HN -->
      <tr class="spacer" style="height:5px"></tr>
    <% end %>
  </tbody>
</table>
