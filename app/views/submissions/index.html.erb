<% content_for :notice_displayed_in_page, "true" %>
<% if notice.present? %>
  <p class="hn-notice"><%= notice %></p>
<% end %>

<% if action_name == "search" %>
  <section class="hn-search" aria-labelledby="search-heading">
    <h1 id="search-heading">Search submissions</h1>
    <% if @query.present? %>
      <% if @submissions.empty? %>
        <p role="status">No submissions found for “<%= @query %>”. Try another word.</p>
      <% else %>
        <p>Results for “<%= @query %>”, sorted by relevance.</p>
      <% end %>
    <% else %>
      <p>Enter a word to search submission titles.</p>
    <% end %>
  </section>
<% end %>

<table class="hn-itemlist" border="0" cellpadding="0" cellspacing="0">
  <tbody>
    <%= render partial: "list_item", collection: @submissions, as: :submission %>
  </tbody>
</table>