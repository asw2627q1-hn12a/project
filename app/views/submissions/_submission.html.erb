<div id="<%= dom_id submission %>">
  <p>
    <strong>Title:</strong>
    <%= submission.title %>
  </p>
  <p>
    <strong>Url:</strong>
    <%= submission.url %>
  </p>
  <p>
    <strong>Points:</strong>
    <%= submission.points %>
  </p>
  <%= render "submissions/vote_button", submission: submission,
             voted: current_user && submission.submission_votes.exists?(user_id: current_user.id) %>
  <p>
    <strong>Submission type:</strong>
    <%= submission.submission_type %>
  </p>
  <p>
    <strong>User:</strong>
    <%= submission.user_id %>
  </p>
</div>
