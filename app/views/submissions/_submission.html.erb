<div id="<%= dom_id submission %>">
  <p>
    <strong>Title:</strong>
    <%= submission.title %>
  </p>

  <p>
    <strong>Url:</strong>
    <%= submission.url %>
  </p>

  <p>
    <strong>Points:</strong>
    <%= submission.points %>
  </p>

  <p>
    <strong>Submission type:</strong>
    <%= submission.submission_type %>
  </p>

  <p>
    <strong>User:</strong>
    <%= submission.user_id %>
  </p>

</div>
