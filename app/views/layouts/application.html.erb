<!DOCTYPE html>
<html>
  <head>
    <title>Hacker News</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
  </head>

  <body>
    <div class="hn-container">
      <!-- Cabecera naranja clásica de HN -->
      <header class="hn-header">
        <div class="hn-header-left">
          <a href="<%= root_path %>" class="hn-logo">Y</a>
          <a href="<%= news_path %>" class="hn-brand">Hacker News</a>
          <nav class="hn-nav">
            <a href="<%= news_path %>">new</a> |
            <a href="#">past</a> |
            <a href="#">comments</a> |
            <a href="#">ask</a> |
            <a href="#">show</a> |
            <a href="<%= new_submission_path %>">submit</a>
          </nav>
        </div>
        <div class="hn-header-right">
          <a href="<%= users_path %>">login</a>
        </div>
      </header>

      <!-- Contenido principal -->
      <main class="hn-main">
        <%= yield %>
      </main>

      <!-- Pie de página clásico -->
      <footer class="hn-footer">
        <hr class="hn-orange-line">
        <div class="hn-footer-links">
          Guidelines | FAQ | Lists | API | Security | Legal | Apply to YC | Contact
        </div>
      </footer>
    </div>
  </body>
</html>