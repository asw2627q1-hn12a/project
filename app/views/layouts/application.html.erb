<!DOCTYPE html>
<html>
  <head>
    <title>Hacker News</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
    <%= yield :head %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="hn-container">
      <!-- Cabecera naranja clásica de HN -->
      <header class="hn-header">
        <div class="hn-header-left">
          <a href="<%= root_path %>" class="hn-logo">Y</a>
          <a href="<%= news_path %>" class="hn-brand">Hacker News</a>
          <nav class="hn-nav" aria-label="Main navigation">
            <%= nav_link "new", newest_path %> |
            <% if current_user %>
              <%= nav_link "threads", threads_path %> |
            <% end %>
            <%= nav_link "comments", comments_path %> |
            <%= nav_link "ask", ask_path %> |
            <%= nav_link "submit", submit_path %>
          </nav>
          <%= form_with url: search_path, method: :get, html: { class: "hn-header-search", role: "search" } do |form| %>
            <%= form.search_field :q, value: @query, placeholder: "Search submissions by title", aria: { label: "Search submissions by title" }, required: true %>
            <%= form.submit "Search" %>
          <% end %>
        </div>
        <div class="hn-header-right" id="login">
          <% if current_user %>
            <%= link_to current_user.username, user_path(current_user), class: "hn-user" %>
            <%= button_to "logout", logout_path, method: :post, class: "hn-auth-button" %>
          <% else %>
            <%= button_to "login", "/auth/github", method: :post, form: { data: { turbo: false } }, class: "hn-auth-button" %>
          <% end %>
        </div>
      </header>

      <!-- Contenido principal -->
      <main class="hn-main">
        <% flash.each do |type, message| %>
          <% unless type.to_s == "notice" && content_for?(:notice_displayed_in_page) %>
            <div class="hn-flash hn-flash-<%= type %>"><%= message %></div>
          <% end %>
        <% end %>

        <%= yield %>
      </main>

      <!-- Pie de página clásico -->
      <footer class="hn-footer">
        <hr class="hn-orange-line">
        <div class="hn-footer-links">
          Guidelines | FAQ | Lists | API | Security | Legal | Apply to YC | Contact
        </div>
      </footer>
    </div>
  </body>
</html>
