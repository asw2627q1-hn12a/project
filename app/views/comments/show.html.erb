<% prepare_comment_votes([ @comment ], include_replies: true) %>
<section class="comments-section">
  <h2>Comment thread</h2>
  <p class="comment-submission">
    Submission: <%= link_to @submission.title, submission_path(@submission, anchor: "comments") %>
  </p>

  <div class="comments-list">
    <%= render "comments/comment", comment: @comment, submission: @submission, force_visible: true %>
  </div>
</section>
