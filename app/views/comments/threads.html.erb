<% prepare_comment_votes(@comments, include_replies: true) %>
<section class="comments-section">
  <h2>Threads by <%= current_user.username %></h2>
  <% if @comments.empty? %>
    <p>You have not posted any comments yet.</p>
  <% else %>
    <% @comments.each do |comment| %>
      <p class="comment-submission">
        On <%= link_to comment.submission.title, submission_path(comment.submission, anchor: "comments") %>
        · <%= link_to "Full thread", submission_comment_path(comment.submission, comment) %>
      </p>
      <%= render "comments/comment", comment: comment, submission: comment.submission %>
    <% end %>
  <% end %>
</section>
