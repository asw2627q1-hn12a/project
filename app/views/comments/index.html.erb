<section class="recent-comments">
  <h2>Comentaris recents</h2>

  <% if @comments.empty? %>
    <p>Encara no hi ha comentaris.</p>
  <% else %>
    <% @comments.each do |comment| %>
      <article id="<%= dom_id(comment) %>" class="recent-comment">
        <%= render "comments/preview", comment: comment %>

        <p class="recent-comment-context">
          A la publicació <%= link_to comment.submission.title, submission_path(comment.submission, anchor: "comments") %>
          <% if comment.parent %>
            · Resposta a <%= link_to comment.parent.user.username,
                                     submission_comment_path(comment.submission, comment.parent) %>
          <% end %>
          · <%= link_to "Fil sencer", submission_comment_path(comment.submission, comment) %>
          · <%= link_to "Respon", new_submission_comment_path(comment.submission, parent_id: comment.id) %>
        </p>
      </article>
    <% end %>
  <% end %>
</section>
