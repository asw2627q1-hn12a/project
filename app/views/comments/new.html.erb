<section class="comments-section">
  <h2>Respon al comentari</h2>

  <div class="reply-context">
    <%= render "comments/preview", comment: @parent_comment %>
  </div>

  <% if current_user %>
    <%= render "comments/form", submission: @submission, comment: @comment %>
  <% else %>
    <p>Per respondre, cal iniciar sessió.</p>
    <%= button_to "Inicia sessió amb GitHub", "/auth/github", method: :post,
                  form: { data: { turbo: false } }, class: "hn-auth-button" %>
  <% end %>

  <%= link_to "Torna a la publicació", submission_path(@submission) %>
</section>
