<section class="comments-section">
  <h2>Reply to comment</h2>

  <div class="reply-context">
    <%= render "comments/preview", comment: @parent_comment %>
  </div>

  <% if current_user %>
    <%= render "comments/form", submission: @submission, comment: @comment %>
  <% else %>
    <p>Please log in to reply.</p>
    <%= button_to "Log in with GitHub", "/auth/github", method: :post,
                  form: { data: { turbo: false } }, class: "hn-auth-button" %>
  <% end %>

  <%= link_to "Back to submission", submission_path(@submission) %>
</section>
