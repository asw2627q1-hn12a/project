<%= form_with(model: [ submission, comment ], class: "comment-form") do |form| %>
  <%= form.hidden_field :parent_id if comment.parent_id.present? %>

  <% if comment.errors.any? %>
    <div class="comment-errors">
      <p>Could not post the comment:</p>
      <ul>
        <% comment.errors.each do |error| %>
          <li>
            <%= case error.attribute
                when :body then "Comment #{error.message}"
                when :parent then "Reply #{error.message}"
                else error.message
                end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p class="comment-current-user">Commenting as <strong><%= current_user.username %></strong></p>

  <div class="comment-form-field">
    <%= form.label :body, "Comment" %>
    <%= form.text_area :body, rows: 4, required: true %>
  </div>

  <%= form.submit comment.parent_id.present? ? "Post reply" : "Post comment" %>
<% end %>
