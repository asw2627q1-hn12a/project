<% thread_path_ids = local_assigns[:thread_path_ids] || [] %>
<% thread_target_id = local_assigns[:thread_target_id] %>
<% thread_target_reached = local_assigns[:thread_target_reached] || comment.id == thread_target_id %>
<% if local_assigns[:force_visible] || thread_path_ids.include?(comment.id) || comment.visible_in_thread? %>
<article id="<%= dom_id(comment) %>" class="comment<%= " comment-selected" if comment.id == thread_target_id %>">
  <%= render "comments/preview", comment: comment %>

  <div class="comment-actions">
    <% if current_user %>
      <%= link_to "Reply", new_submission_comment_path(submission, parent_id: comment.id), class: "comment-reply" %>
      <% if current_user == comment.user && !comment.deleted? %>
        <%= link_to "Edit", edit_submission_comment_path(submission, comment, return_to: return_to_here), class: "comment-action" %>
        <%= button_to "Delete", submission_comment_path(submission, comment), method: :delete,
                      params: { return_to: return_to_here },
                      class: "comment-action comment-delete",
                      form: { data: { turbo_confirm: "Delete this comment? Replies will be preserved." } } %>
      <% end %>
    <% else %>
      <%= button_to "Log in to reply", "/auth/github", method: :post,
                    form: { data: { turbo: false }, class: "comment-login-form" }, class: "comment-reply" %>
    <% end %>
  </div>

  <% visible_replies = visible_replies_for_thread(
       comment, path_ids: thread_path_ids, target_reached: thread_target_reached
     ) %>
  <% if visible_replies.any? %>
    <div class="comment-replies">
      <%= render partial: "comments/comment", collection: visible_replies,
                 as: :comment,
                 locals: { submission: submission, thread_path_ids: thread_path_ids,
                           thread_target_id: thread_target_id, thread_target_reached: thread_target_reached } %>
    </div>
  <% end %>
</article>
<% end %>