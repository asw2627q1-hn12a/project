<% if local_assigns[:force_visible] || comment.visible_in_thread? %>
<article id="<%= dom_id(comment) %>" class="comment">
  <%= render "comments/preview", comment: comment %>

  <div class="comment-actions">
    <% if current_user %>
      <%= link_to "Reply", new_submission_comment_path(submission, parent_id: comment.id), class: "comment-reply" %>
      <% if current_user == comment.user && !comment.deleted? %>
        <%= link_to "Edit", edit_submission_comment_path(submission, comment), class: "comment-action" %>
        <%= button_to "Delete", submission_comment_path(submission, comment), method: :delete,
                      class: "comment-action comment-delete",
                      form: { data: { turbo_confirm: "Delete this comment? Replies will be preserved." } } %>
      <% end %>
    <% else %>
      <%= button_to "Log in to reply", "/auth/github", method: :post,
                    form: { data: { turbo: false }, class: "comment-login-form" }, class: "comment-reply" %>
    <% end %>
  </div>

  <% visible_replies = comment.replies.includes(:user).order(:created_at).select(&:visible_in_thread?) %>
  <% if visible_replies.any? %>
    <div class="comment-replies">
      <%= render partial: "comments/comment", collection: visible_replies,
                 as: :comment, locals: { submission: submission } %>
    </div>
  <% end %>
</article>
<% end %>