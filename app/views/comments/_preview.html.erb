<% voted = comment_voted?(comment) %>
<div class="comment-header">
  <% if !comment.deleted? && !voted && (!current_user || comment.user_id != current_user.id) %>
    <%= render "comments/vote_button", comment: comment, voted: false %>
  <% end %>
  <div class="comment-meta">
    <% if comment.deleted? %>
      <span class="comment-author-deleted"><em>[<%= t("comments.deleted") %>]</em></span>
    <% else %>
      <span class="comment-score"><%= pluralize(comment.points, "point") %></span>
      ·
      <%= link_to comment.user.username, user_path(comment.user), class: "comment-author" %>
    <% end %>
    <%= link_to "#{time_ago_in_words(comment.created_at)} ago",
                submission_path(comment.submission, anchor: dom_id(comment)), class: "comment-age" %>
    <% if comment.parent %>
      | Reply to <%= link_to(comment.parent.deleted? ? tag.em("[#{t("comments.deleted")}]") : comment.parent.user.username,
                               submission_comment_path(comment.submission, comment.parent)) %>
    <% end %>
    | <span class="comment-thread-actions">
      <%= link_to "Full thread", submission_comment_path(comment.submission, comment) %>
      <% if current_user && (!comment.deleted? || favorited?(comment)) %>
        | <%= render "shared/favorite_button", record: comment, icon_only: true %>
      <% end %>
    </span>
    <% if current_user && comment.user_id != current_user.id && voted %>
      | <%= render "comments/vote_button", comment: comment, voted: true %>
    <% end %>
  </div>
</div>
<div class="comment-body">
  <% if comment.deleted? %>
    <p class="comment-deleted"><em>[<%= t("comments.deleted") %>]</em></p>
  <% else %>
    <%= simple_format(comment.body) %>
  <% end %>
</div>
